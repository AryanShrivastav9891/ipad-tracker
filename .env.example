# Isko copy karke .env.local banao aur wahan asli values daalo.
# .env.local .gitignore me hai - wo kabhi git me nahi jayegi.
# Ye .env.example file me KABHI asli token mat likhna.
#
#   cp .env.example .env.local
#   nano .env.local
#
